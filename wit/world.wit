package docs:getcoordsfromaddressworld@0.1.0;

interface getcoordsfromaddress {
	record address {
		street: string,
		streetnumber: string,
		zip: string,
		town: string,
		region: option<string>,
		count: option<u32>,
	}

	record coordinates {
		longitude: f64,
		latitude: f64,
	}

	getcoordsfromaddress: func(address: address) -> coordinates;
}

world getcoordsfromaddressworld {
	export getcoordsfromaddress;
